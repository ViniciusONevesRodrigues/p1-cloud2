<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Locadora Vinicius</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f5f5f5;
      color: #333;
    }

    header {
      background-color: #007bff;
      color: #fff;
      padding: 15px 0;
    }

    .navbar {
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
    }

    .nav-logo a {
      color: #fff;
      text-decoration: none;
      font-weight: bold;
      font-size: 1.5rem;
    }

    .nav-links {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
    }

    .nav-links a:hover {
      text-decoration: underline;
    }


    /* Responsivo */
    @media (max-width: 600px) {
      .navbar {
        flex-direction: column;
        gap: 10px;
      }

      .nav-links {
        flex-direction: column;
        gap: 10px;
      }
    }
  </style>
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="nav-logo">
        <a href="/"> Locadora Vinicius</a>
      </div>
      <ul class="nav-links">
        <li><a href="/vehicles">Veículos</a></li>
        <li><a href="/clients">Clientes</a></li>
        <li><a href="/rentals">Locações</a></li>
      </ul>
    </nav>
  </header>

  <main class="container">
    {{#if success_msg}}<div class="flash success">{{success_msg}}</div>{{/if}}
    {{#if error_msg}}<div class="flash error">{{error_msg}}</div>{{/if}}
    {{{body}}}
  </main>
</body>
</html>
