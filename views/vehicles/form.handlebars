<link rel="stylesheet" href="/css/formStyles.css">
<h1>{{#if vehicle.rowKey}}Editar Veículo{{else}}Novo Veículo{{/if}}</h1>

<form action="{{#if vehicle.rowKey}}/vehicles/{{vehicle.rowKey}}?_method=PUT{{else}}/vehicles{{/if}}" method="POST" enctype="multipart/form-data">
  <div>
    <label for="brand">Marca:</label>
    <input type="text" name="brand" id="brand" value="{{vehicle.brand}}" required>
  </div>

  <div>
    <label for="model">Modelo:</label>
    <input type="text" name="model" id="model" value="{{vehicle.model}}" required>
  </div>

  <div>
    <label for="year">Ano:</label>
    <input type="number" name="year" id="year" value="{{vehicle.year}}" required>
  </div>

  <div>
    <label for="plate">Placa:</label>
    <input type="text" name="plate" id="plate" value="{{vehicle.plate}}" required>
  </div>

  <div>
    <label for="price">Preço:</label>
    <input type="number" step="0.01" name="price" id="price" value="{{vehicle.price}}" required>
  </div>

  <div>
    <label for="available">Disponível:</label>
    <input type="checkbox" name="available" id="available" {{#if vehicle.available}}checked{{/if}}>
  </div>

  <div>
    <label for="photo">Foto:</label>
    <input type="file" name="photo" id="photo" accept="image/*">
    {{#if vehicle.photoUrl}}
      <br>
      <img src="{{vehicle.photoUrl}}" alt="Foto do veículo" style="max-width:200px;">
    {{/if}}
  </div>

  {{!-- Para editar, precisamos manter o partitionKey --}}
  {{#if vehicle.partitionKey}}
    <input type="hidden" name="partitionKey" value="{{vehicle.partitionKey}}">
  {{/if}}

  <div>
    <button type="submit">{{#if vehicle.rowKey}}Atualizar{{else}}Cadastrar{{/if}}</button>
  </div>
  
</form>
