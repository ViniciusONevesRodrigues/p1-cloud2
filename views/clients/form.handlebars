<link rel="stylesheet" href="/css/formStyles.css">
<h1>{{#if client.rowKey}}Editar Cliente{{else}}Cadastrar Cliente{{/if}}</h1>

<form action="{{#if client.rowKey}}/clients/{{client.rowKey}}?_method=PUT{{else}}/clients{{/if}}" method="post">
  <div>
    <label>Nome:</label>
    <input type="text" name="name" value="{{client.name}}" required>
  </div>
  <div>
    <label>Email:</label>
    <input type="email" name="email" value="{{client.email}}" required>
  </div>
  <div>
    <label>Telefone:</label>
    <input type="text" name="phone" value="{{client.phone}}">
  </div>
  <div>
    <label>Endereço:</label>
    <input type="text" name="address" value="{{client.address}}">
  </div>

  <button type="submit">{{#if client.rowKey}}Atualizar{{else}}Cadastrar{{/if}}</button>
  <a href="/clients">Cancelar</a>
</form>

